# .env.example

# Telegram API credentials (keep real values out of version control)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_PHONE_NUMBER=

# LLM backend settings (choose either ollama or openai)
# Ollama (local JSON-mode)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_CTX=32000 
LLM_BATCH=12
LLM_N_GPU_LAYERS=40

# FX & state targets
STATE_PATH=state.sqlite
FX_SOURCE=https://open.er-api.com/v6
